{
  "name": "@osborn-pa/table-view",
  "version": "0.1.0",
  "private": true,
  "description": "Osborn PA workbench packaged as a Feishu Base table-view extension (enterprise self-built app).",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:ids": "node prepare.mjs",
    "dev": "cd block && NODE_ENV=development webpack serve --config ../webpack.config.cjs",
